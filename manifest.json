{
  "manifest_version": 3,
  "name": "Norn Draft",
  "version": "0.1.0",
  "description": "Initial scaffold for the Norn Draft browser extension.",
  "action": {
    "default_title": "Norn Draft",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
