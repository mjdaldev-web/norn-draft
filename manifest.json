{
  "manifest_version": 3,
  "name": "Norn Draft",
  "version": "1.0.0",
  "description": "Draft and rewrite polished AI replies with tone presets using your own Gemini API key.",
  "action": {
    "default_title": "Norn Draft",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
}
